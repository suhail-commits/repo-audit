# Normalise to LF in the repository regardless of the checkout platform.
# Without this, working on Windows stores CRLF and every file shows as modified
# for anyone on another OS — and the diff of a one-line change is the whole file.
* text=auto eol=lf

# Lockfiles are generated; keep them out of diffs and language stats.
pnpm-lock.yaml linguist-generated=true -diff
