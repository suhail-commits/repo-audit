{
  "name": "vibe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty && pnpm --filter @vibe/web typecheck",
    "scan": "tsx packages/cli/src/index.ts --signals",
    "report": "tsx packages/cli/src/index.ts",
    "web": "pnpm --filter @vibe/web dev",
    "seed": "pnpm --filter @vibe/web seed",
    "sweep": "tsx scripts/false-positive-sweep.ts",
    "repo-audit": "tsx packages/cli/src/index.ts",
    "build": "tsx scripts/build-cli.ts",
    "verify:package": "tsx scripts/verify-package.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
