# Copy to .env.local (git-ignored) and fill in.
# Both are optional for local development; both are required in production.

# Neon Postgres connection string.
# Without it the app uses an in-memory store: scans work, but vanish on restart.
# Get one free at https://neon.tech — copy the pooled connection string.
DATABASE_URL=

# GitHub personal access token, no scopes needed for public repositories.
#
# Without it the API allows 60 requests/hour across ALL visitors, which a public
# deployment exhausts almost immediately. With it, 5,000/hour.
#
# It also unlocks GraphQL, which is the only way we get per-commit line counts —
# so without a token the `commit-size` signal reports as unavailable.
#
# Create at https://github.com/settings/tokens (fine-grained, public read-only).
GITHUB_TOKEN=

# Any random string. Salts the hash used to tell one caller from another for
# rate limiting — the address itself is never stored.
#
# Without it every visitor shares a single bucket, so the per-caller burst limit
# applies to everyone at once. That fails toward limiting more, not less, so the
# app still runs; it is just needlessly strict.
#
# It must be a secret. An unsalted SHA-256 of an IPv4 address is not anonymous:
# the whole space is four billion entries, so anyone holding the table can
# reverse it by brute force.
#
# Generate with: node -e "console.log(crypto.randomUUID())"
RATE_LIMIT_SALT=
